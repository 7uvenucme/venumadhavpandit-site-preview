---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const builds = (await getCollection('builds')).filter(x=>x.data.featured).sort((a,b)=>(b.data.year??0)-(a.data.year??0));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Marketing, digital ideas and builds" description="Venumadhav Pandit is a Mumbai-based marketer and builder sharing digital products, campaigns and creative experiments."><section class="hero"><div class="container hero-grid"><div><span class="eyebrow">Marketing × making · Mumbai, India</span><h1>Ideas I make <em>real.</em></h1><p>I'm Venumadhav Pandit. I work across brand, content and digital, and I build things worth sharing. This is where the projects live.</p><a class="button" href={`${base}/builds/`}>Explore my builds <span aria-hidden="true">↗</span></a></div><figure class="hero-art"><img src={`${base}/images/flying-chairs.png`} alt="A green chair stands still while orange chairs fly around it, artwork by Venumadhav Pandit"/><figcaption>Artwork by Venumadhav Pandit</figcaption></figure></div></section><section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Selected work</span><h2>Recent builds</h2></div><a href={`${base}/builds/`}>All builds ↗</a></div><div class="project-grid">{builds.map(build=><a class="project-card" href={`${base}/builds/${build.id}/`}><div class="visual">{build.data.image ? <img src={`${base}${build.data.cardImage || build.data.image}`} alt={build.data.imageAlt || ''} loading="lazy"/> : <span class="monogram" aria-hidden="true">{build.id==='mfan-2026'?'MF':'EV'}</span>}</div><div class="card-body"><span class="eyebrow">{build.data.eyebrow}{build.data.year ? ` · ${build.data.year}` : ""}</span><h3>{build.data.title}</h3><p>{build.data.summary}</p></div><span class="arrow">Explore project ↗</span></a>)}</div></div></section></Base>
