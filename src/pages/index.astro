---
import Base from '../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
const d = (await getEntry('pages', 'home'))!.data;
const builds = (await getCollection('builds')).filter(x=>x.data.featured).sort((a,b)=>(b.data.year??0)-(a.data.year??0));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={d.title} description={d.description}><section class="hero"><div class="container hero-grid"><div><span class="eyebrow">{d.heroEyebrow}</span><h1 set:html={d.heroTitle}></h1><p>{d.heroIntro}</p><a class="button" href={`${base}/builds/`}>{d.heroButtonLabel} <span aria-hidden="true">↗</span></a></div><figure class="hero-art"><img src={`${base}${d.heroImage}`} alt={d.heroImageAlt}/><figcaption>{d.heroImageCaption}</figcaption></figure></div></section><section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">{d.sectionEyebrow}</span><h2>{d.sectionTitle}</h2></div><a href={`${base}/builds/`}>{d.sectionLinkLabel} ↗</a></div><div class="project-grid">{builds.map(build=><a class="project-card" href={`${base}/builds/${build.id}/`}><div class="visual">{build.data.image ? <img src={`${base}${build.data.cardImage || build.data.image}`} alt={build.data.imageAlt || ''} loading="lazy"/> : <span class="monogram" aria-hidden="true">{build.id==='mfan-2026'?'MF':'EV'}</span>}</div><div class="card-body"><span class="eyebrow">{build.data.eyebrow}{build.data.year ? ` · ${build.data.year}` : ""}</span><h3>{build.data.title}</h3><p>{build.data.summary}</p></div><span class="arrow">Explore project ↗</span></a>)}</div></div></section></Base>
