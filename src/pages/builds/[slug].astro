---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const builds=await getCollection('builds');return builds.map(build=>({params:{slug:build.id},props:{build}}));}
const {build}=Astro.props;
const {Content}=await render(build);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={build.data.title} description={build.data.summary} socialImage={build.data.cardImage || build.data.image}><div class="container page-intro"><a class="text-link" href={`${base}/builds/`}>← All builds</a><p class="eyebrow" style="margin-top:45px">{build.data.eyebrow}{build.data.year ? ` · ${build.data.year}` : ""}</p><h1 class:list={["page-title", {"long-title": build.data.title.length > 18}]}>{build.data.title}</h1><p class="lede">{build.data.summary}</p></div><article class="container content">{build.data.image && <figure><img src={`${base}${build.data.image}`} alt={build.data.imageAlt || ''}/><figcaption>{build.data.imageCredit}</figcaption></figure>}<Content /></article></Base>
