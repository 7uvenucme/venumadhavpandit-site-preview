---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import { existsSync } from 'node:fs';
const d = (await getEntry('pages', 'builds-index'))!.data;
const builds = (await getCollection('builds')).sort((a,b)=>(b.data.year??0)-(a.data.year??0));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cardSrcset = (p?: string) => {
  if (!p || !p.endsWith('.webp')) return undefined;
  const small = p.replace(/\.webp$/, '-550.webp');
  return existsSync(`public${small}`) ? `${base}${small} 550w, ${base}${p} 800w` : undefined;
};
const cardSizes = '(max-width: 720px) calc(100vw - 36px), 549px';
---
<Base title={d.title} description={d.description}><div class="container page-intro"><span class="eyebrow">{d.eyebrow}</span><h1 class="page-title">{d.pageTitle}</h1><p class="lede">{d.lede}</p></div><section class="container section" style="padding-top:0"><div class="project-grid">{builds.map(build=><a class="project-card" href={`${base}/builds/${build.id}/`}><div class="visual">{build.data.image ? <img src={`${base}${build.data.cardImage || build.data.image}`} srcset={cardSrcset(build.data.cardImage)} sizes={cardSrcset(build.data.cardImage) ? cardSizes : undefined} alt={build.data.imageAlt || ''} loading="lazy"/> : <span class="monogram" aria-hidden="true">{build.id==='mfan-2026'?'MF':'EV'}</span>}</div><div class="card-body"><span class="eyebrow">{build.data.eyebrow}{build.data.year ? ` · ${build.data.year}` : ""}</span><h3>{build.data.title}</h3><p>{build.data.summary}</p></div><span class="arrow">Explore project ↗</span></a>)}</div></section></Base>
