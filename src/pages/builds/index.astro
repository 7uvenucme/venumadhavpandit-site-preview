---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const builds = (await getCollection('builds')).sort((a,b)=>(b.data.year??0)-(a.data.year??0));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Builds - projects and campaigns" description="Explore Venumadhav Pandit’s projects: MFan cricket predictions, #HeartsToBravehearts, an EV calculator and more."><div class="container page-intro"><span class="eyebrow">The work</span><h1 class="page-title">Things I've built.</h1><p class="lede">Products, experiments and campaigns. Each started with a question worth testing.</p></div><section class="container section" style="padding-top:0"><div class="project-grid">{builds.map(build=><a class="project-card" href={`${base}/builds/${build.id}/`}><div class="visual">{build.data.image ? <img src={`${base}${build.data.cardImage || build.data.image}`} alt={build.data.imageAlt || ''} loading="lazy"/> : <span class="monogram" aria-hidden="true">{build.id==='mfan-2026'?'MF':'EV'}</span>}</div><div class="card-body"><span class="eyebrow">{build.data.eyebrow}{build.data.year ? ` · ${build.data.year}` : ""}</span><h3>{build.data.title}</h3><p>{build.data.summary}</p></div><span class="arrow">Explore project ↗</span></a>)}</div></section></Base>
