---
import Base from '../layouts/Base.astro';
---
<Base title="Learn Kannada Online - Free Alphabet Quiz | Venumadhav Pandit" description="Learn to read Kannada free. Practice the alphabet and vowel combinations in 60-second quizzes. No login, no download." socialTitle="Learn Kannada Online - Free Alphabet Quiz" socialDescription="Learn to read Kannada free. Practice the alphabet and vowel combinations in 60-second quizzes. No login, no download." socialImage="/images/learn-kannada-share.jpg">
<section class="lk container">
  <p class="lk-eyebrow">Learn to read Kannada</p>
  <div id="lk-app" class="lk-card" aria-live="polite">
    <div id="lk-start">
      <h1 class="lk-title">Read the script, one letter at a time.</h1>
      <p class="lk-sub" id="lk-instructions">Tap the letters you want to practice. Then you get 60 seconds to match each one to its sound.</p>
      <div id="lk-level-picker" class="lk-level-picker" aria-label="Practice level"></div>
      <div class="lk-tools"><button type="button" id="lk-all">Select all</button><button type="button" id="lk-none">Clear</button></div>
      <div id="lk-levels" class="lk-levels"></div>
      <button class="lk-btn" id="lk-go" type="button">Start</button>
      <p class="lk-need" id="lk-need" hidden>Pick at least 4 letters.</p>
      <p class="lk-note">Free. No login. No download.</p>
      <p class="lk-note">Nothing is saved. Refresh and it starts fresh.</p>
    </div>
    <div id="lk-play" hidden>
      <p id="lk-challenge-note" class="lk-challenge-note" hidden>Same 20 questions. Beat their score!</p>
      <div class="lk-top"><div class="lk-stat"><small>Score</small><span id="lk-score">0</span></div><div class="lk-stat lk-r"><small>Time left</small><span id="lk-time">60s</span></div></div>
      <div class="lk-bar"><i id="lk-bar-fill"></i></div>
      <div id="lk-glyph" class="lk-glyph" lang="kn">ಅ</div>
      <div id="lk-opts" class="lk-opts"></div>
    </div>
    <div id="lk-end" hidden>
      <p class="lk-sub">Time</p>
      <div id="lk-final" class="lk-final">0</div>
      <p id="lk-summary" class="lk-sub"></p>
      <p id="lk-comparison" class="lk-comparison" hidden></p>
      <div id="lk-missed" class="lk-missed"></div>
      <div id="lk-share" class="lk-share" aria-label="Challenge a friend">
        <p class="lk-share-title">Challenge a friend</p>
        <div class="lk-share-actions">
          <button class="lk-share-btn" id="lk-native-share" type="button" hidden><span aria-hidden="true">↗</span><span>Share</span></button>
          <a class="lk-share-btn lk-share-link" id="lk-share-whatsapp" target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 2 17.7L.5 23.5l6-1.6A11.8 11.8 0 0 0 23.2 11a11.8 11.8 0 0 0-2.7-7.5ZM12 21a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.6 1 1-3.5-.3-.4A9.8 9.8 0 1 1 12 21Zm5.4-7.4c-.3-.2-1.7-.9-2-.9-.2-.1-.4-.2-.6.2-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.2-1.2-.4-2.3-1.4-.8-.7-1.4-1.6-1.6-1.9-.2-.3 0-.4.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.1c-.2-.5-.5-.4-.6-.4h-.5c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.4s1 2.7 1.1 2.9c.1.2 2 3.1 4.8 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4Z"/></svg><span>WhatsApp</span></a>
          <a class="lk-share-btn lk-share-link" id="lk-share-x" target="_blank" rel="noopener noreferrer" aria-label="Share on X"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.6 22H2.4l7.3-8.4L1.8 2h6.4l4.5 6.8L18.9 2Zm-1.1 18h1.7L7.3 3.9H5.5L17.8 20Z"/></svg><span>X</span></a>
          <a class="lk-share-btn lk-share-link" id="lk-share-linkedin" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 2H3.6A1.6 1.6 0 0 0 2 3.6v16.8A1.6 1.6 0 0 0 3.6 22h16.8a1.6 1.6 0 0 0 1.6-1.6V3.6A1.6 1.6 0 0 0 20.4 2ZM8 18H5V9h3v9ZM6.5 7.8A1.8 1.8 0 1 1 6.5 4a1.8 1.8 0 0 1 0 3.8ZM19 18h-3v-4.4c0-1.1 0-2.4-1.5-2.4s-1.7 1.2-1.7 2.3V18h-3V9h2.9v1.2h.1A3.2 3.2 0 0 1 15.7 9C18.8 9 19 11 19 13.6V18Z"/></svg><span>LinkedIn</span></a>
          <a class="lk-share-btn lk-share-link" id="lk-share-facebook" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.4 22v-9h3l.5-3.5h-3.5V7.3c0-1 .3-1.7 1.8-1.7H17V2.5c-.3 0-1.4-.1-2.7-.1-2.7 0-4.6 1.6-4.6 4.7v2.4H6.6V13h3.1v9h3.7Z"/></svg><span>Facebook</span></a>
          <button class="lk-share-btn" id="lk-copy-link" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.1 0l3-3A5 5 0 0 0 13 2.9l-1.7 1.7 1.4 1.4 1.7-1.7a3 3 0 0 1 4.2 4.2l-3 3a3 3 0 0 1-4.2 0l-.7-.7-1.4 1.4.7.8ZM14 11a5 5 0 0 0-7.1 0l-3 3A5 5 0 0 0 11 21.1l1.7-1.7-1.4-1.4-1.7 1.7a3 3 0 0 1-4.2-4.2l3-3a3 3 0 0 1 4.2 0l.7.7 1.4-1.4-.7-.8Z"/></svg><span id="lk-copy-label">Copy link</span></button>
        </div>
      </div>
      <button class="lk-btn" id="lk-again" type="button">Play again</button>
    </div>
  </div>
</section>
</Base>
<style is:global>
.lk{padding:40px 0 72px;max-width:560px}
.lk-eyebrow{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#945013;font-weight:700;margin:0 0 14px}
.lk-card{background:linear-gradient(160deg,#fff 0%,#f1f3e4 60%,#f8e9db 100%);border:1px solid #e4e6d6;border-radius:28px;padding:28px 22px;box-shadow:0 18px 40px -24px rgba(60,70,20,.35);min-height:420px}
.lk-title{font-size:clamp(28px,7vw,38px);line-height:1.1;letter-spacing:-.04em;margin:0 0 12px;color:#19252b}
.lk-sub{color:#5a6663;font-size:17px;margin:0 0 22px}
.lk-note{color:#7a8582;font-size:13px;margin:16px 0 0}
.lk-levels{margin-bottom:20px}
.lk-level-picker{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0 0 16px}
.lk-level-choice{padding:10px 8px;border-radius:12px;border:2px solid #dfe3cc;background:#fff;font:inherit;font-size:14px;font-weight:700;color:#19252b;cursor:pointer}
.lk-level-choice[aria-pressed=true]{border-color:#6b7a2a;background:#f1f6dc;color:#425018}
.lk-ch small{font-size:12px}
.lk-h{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#945013;font-weight:700;margin:16px 0 8px}
.lk-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.lk-ch{display:flex;flex-direction:column;align-items:center;padding:10px 2px 8px;border-radius:14px;border:2px solid #dfe3cc;background:#fff;font:inherit;color:#19252b;cursor:pointer}
.lk-ch b{font-size:30px;line-height:1.25;font-weight:500}
.lk-ch small{font-size:13px;color:#6b7773}
.lk-ch[aria-pressed=true]{border-color:#6b7a2a;background:#f1f6dc}
.lk-ch[aria-pressed=false]{opacity:.55}
.lk-tools{display:flex;gap:16px;margin-bottom:4px}
.lk-tools button{background:none;border:0;padding:6px 0;font:inherit;font-size:14px;font-weight:600;color:#945013;cursor:pointer}
.lk-need{color:#c2560f;font-size:14px;margin:10px 0 0}
.lk-xlevel{display:flex;justify-content:space-between;align-items:center;width:100%;text-align:left;padding:14px 16px;border-radius:16px;border:2px solid #dfe3cc;background:#fff;font:inherit;color:#19252b;cursor:pointer}
.lk-level small{color:#6b7773;font-size:13px}
.lk-level[aria-pressed=true]{border-color:#6b7a2a;background:#f4f7e6}
.lk-level[disabled]{opacity:.5;cursor:default}
.lk-btn{width:100%;padding:16px;border:0;border-radius:16px;background:#c2560f;color:#fff;font:inherit;font-weight:700;font-size:18px;cursor:pointer;min-height:54px}
.lk-btn:hover{background:#a8480a}
.lk-top{display:flex;justify-content:space-between;align-items:flex-end}.lk-stat{display:flex;flex-direction:column;line-height:1.1}.lk-stat small{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#6b7773;font-weight:600;margin-bottom:4px}.lk-stat span{font-weight:800;font-size:30px;letter-spacing:-.03em}.lk-r{align-items:flex-end}
.lk-top #lk-score{color:#5d6b1f}.lk-top #lk-time{color:#c2560f;font-variant-numeric:tabular-nums}
.lk-bar{height:6px;background:#e4e6d6;border-radius:6px;margin:10px 0 18px;overflow:hidden}
.lk-bar i{display:block;height:100%;width:100%;background:linear-gradient(90deg,#6b7a2a,#c2560f);transition:width 1s linear}
.lk-glyph{font-size:clamp(110px,34vw,160px);line-height:1.2;text-align:center;color:#19252b;padding:8px 0 20px}
.lk-opts{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.lk-opt{padding:18px 8px;border-radius:16px;border:2px solid #dfe3cc;background:#fff;font:inherit;font-size:22px;font-weight:600;color:#19252b;cursor:pointer;min-height:64px}
.lk-opt.ok{background:#e4efc4;border-color:#6b7a2a}
.lk-opt.bad{background:#f8d9c4;border-color:#c2560f}
.lk-final{font-size:84px;font-weight:800;letter-spacing:-.05em;color:#5d6b1f;line-height:1;margin:6px 0 10px}
.lk-missed{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 22px}
.lk-chip{background:#fff;border:1px solid #e4e6d6;border-radius:12px;padding:8px 12px;font-size:15px}
.lk-chip b{font-size:22px;margin-right:6px}
.lk-challenge-note{margin:0 0 10px;color:#945013;font-size:14px;font-weight:700}.lk-comparison{margin:0 0 20px;padding:12px 14px;background:#f1f6dc;border:1px solid #dfe3cc;border-radius:14px;color:#425018;font-weight:700;font-size:16px}.lk-share{margin:0 0 22px;padding:16px;background:rgba(255,255,255,.65);border:1px solid #e4e6d6;border-radius:18px}.lk-share-title{font-size:15px;font-weight:700;color:#19252b;margin:0 0 12px}.lk-share-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.lk-share-btn{display:flex;align-items:center;justify-content:center;gap:7px;min-height:42px;padding:8px 6px;border:1px solid #dfe3cc;border-radius:12px;background:#fff;color:#425018;text-decoration:none;font:inherit;font-size:13px;font-weight:700;cursor:pointer}.lk-share-btn:hover{background:#f1f6dc;border-color:#6b7a2a}.lk-share-btn svg{width:18px;height:18px;fill:currentColor;flex:none}
@media(max-width:420px){.lk-share-actions{grid-template-columns:repeat(2,minmax(0,1fr))}.lk-share-btn{gap:6px;padding:8px 4px;font-size:12px}}
</style>
<script>
// Content is data. To add a level later (two-letter sounds, common words),
// push another object into LEVELS with the same shape. Nothing else changes.
type Item = { k: string; r: string; family?: string };
type Group = { title: string; items: Item[]; families?: Item[] };
type Level = { id: string; title: string; groups: Group[] };
const v = (k: string, r: string, family?: string): Item => ({ k, r, family });
const baseGroups = [
  { title: 'Vowels', items: [
    v('ಅ','a'),v('ಆ','aa'),v('ಇ','i'),v('ಈ','ee'),v('ಉ','u'),v('ಊ','oo'),v('ಋ','ru'),
    v('ಎ','e'),v('ಏ','ae'),v('ಐ','ai'),v('ಒ','o'),v('ಓ','oh'),v('ಔ','au'),v('ಅಂ','am'),v('ಅಃ','ah') ] },
  { title: 'Consonants', items: [
    v('ಕ','ka'),v('ಖ','kha'),v('ಗ','ga'),v('ಘ','gha'),v('ಙ','nga'),
    v('ಚ','cha'),v('ಛ','chha'),v('ಜ','ja'),v('ಝ','jha'),v('ಞ','nya'),
    v('ಟ','tta'),v('ಠ','ttha'),v('ಡ','dda'),v('ಢ','ddha'),v('ಣ','nna'),
    v('ತ','tha'),v('ಥ','thha'),v('ದ','da'),v('ಧ','dha'),v('ನ','na'),
    v('ಪ','pa'),v('ಫ','pha'),v('ಬ','ba'),v('ಭ','bha'),v('ಮ','ma'),
    v('ಯ','ya'),v('ರ','ra'),v('ಲ','la'),v('ವ','va'),v('ಶ','sha'),
    v('ಷ','shha'),v('ಸ','sa'),v('ಹ','ha'),v('ಳ','lla') ] }
];
const consonants = baseGroups[1].items;
const signs = [
  { sign:'', roman:'a' }, { sign:'ಾ', roman:'aa' }, { sign:'ಿ', roman:'i' }, { sign:'ೀ', roman:'ee' },
  { sign:'ು', roman:'u' }, { sign:'ೂ', roman:'oo' }, { sign:'ೃ', roman:'ru' }, { sign:'ೆ', roman:'e' },
  { sign:'ೇ', roman:'ae' }, { sign:'ೈ', roman:'ai' }, { sign:'ೊ', roman:'o' }, { sign:'ೋ', roman:'oh' },
  { sign:'ೌ', roman:'au' }, { sign:'ಂ', roman:'am' }, { sign:'ಃ', roman:'ah' }
];
const familySets = [
  { title:'Velars', ids:['ಕ','ಖ','ಗ','ಘ','ಙ'] },
  { title:'Palatals', ids:['ಚ','ಛ','ಜ','ಝ','ಞ'] },
  { title:'Retroflex', ids:['ಟ','ಠ','ಡ','ಢ','ಣ'] },
  { title:'Dentals', ids:['ತ','ಥ','ದ','ಧ','ನ'] },
  { title:'Labials', ids:['ಪ','ಫ','ಬ','ಭ','ಮ'] },
  { title:'Other consonants', ids:['ಯ','ರ','ಲ','ವ','ಶ','ಷ','ಸ','ಹ','ಳ'] }
];
const comboGroups: Group[] = familySets.map(set => {
  const families = consonants.filter(c => set.ids.includes(c.k));
  const items = families.flatMap(c => signs.map(sign => {
    const stem = c.r.slice(0, -1);
    return v(c.k + sign.sign, stem + sign.roman, c.k);
  }));
  return { title:set.title, items, families };
});
const LEVELS: Level[] = [
  { id:'letters', title:'Single letters', groups:baseGroups },
  { id:'combos', title:'Vowel combinations', groups:comboGroups }
];
const $ = (id: string) => document.getElementById(id)!;
const DURATION = 60;
let level = LEVELS[0]; let ALL = level.groups.flatMap(g => g.items); let pool: Item[] = ALL;
const selectionKeys = (target: Level) => target.id === 'combos'
  ? target.groups.flatMap(g => g.families || []).map(f => f.k)
  : target.groups.flatMap(g => g.items).map(i => i.k);
let sel = new Set<string>(selectionKeys(level)); let score = 0, asked = 0, left = DURATION, timer: number | undefined, cur: Item, locked = false;
let missed = new Map<string, Item>();
const shuffle = <T,>(a: T[]) => { a = a.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
const makeRound = (items: Item[]): Item[] => items.length >= 20 ? shuffle(items).slice(0, 20) : shuffle(Array.from({ length: 20 }, (_, i) => items[i % items.length]));
let round: Item[] = []; let roundIndex = 0;
function readChallenge(): { level: Level; score: number; questions: Item[] } | null {
  try {
    const raw = new URLSearchParams(location.search).get('challenge');
    if (!raw || !/^[A-Za-z0-9_-]{1,300}$/.test(raw)) return null;
    const binary = atob(raw.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - raw.length % 4) % 4));
    const data = JSON.parse(binary);
    if (!Array.isArray(data) || data.length !== 22) return null;
    const challengeLevel = LEVELS.find(candidate => candidate.id === data[0]);
    const challengeScore = data[1];
    if (!challengeLevel || !Number.isInteger(challengeScore) || challengeScore < 0 || challengeScore > 20) return null;
    const items = challengeLevel.groups.flatMap(group => group.items);
    const questions: Item[] = data.slice(2).map(index => Number.isInteger(index) && index >= 0 && index < items.length ? items[index] : null).filter((item): item is Item => item !== null);
    if (questions.length !== 20) return null;
    return { level: challengeLevel, score: challengeScore, questions };
  } catch { return null; }
}
let challengeToPlay = readChallenge();
let challengerScore: number | null = challengeToPlay?.score ?? null;
function setLevel(next: Level) {
  level = next; ALL = level.groups.flatMap(g => g.items); pool = ALL;
  sel = new Set(selectionKeys(level)); renderLevels();
}
function renderLevels() {
  const picker = $('lk-level-picker'); picker.innerHTML = '';
  LEVELS.forEach(l => {
    const b = document.createElement('button'); b.type = 'button'; b.className = 'lk-level-choice';
    b.setAttribute('aria-pressed', String(level.id === l.id)); b.textContent = l.title;
    b.onclick = () => { if (level.id !== l.id) setLevel(l); };
    picker.appendChild(b);
  });
  $('lk-instructions').textContent = level.id === 'combos'
    ? 'Choose the consonant families you want to practice. Each one pairs with all 15 vowel sounds.'
    : 'Tap the letters you want to practice. Then you get 60 seconds to match each one to its sound.';
  const box = $('lk-levels'); box.innerHTML = '';
  level.groups.forEach(g => {
    const h = document.createElement('div'); h.className = 'lk-h'; h.textContent = g.title; box.appendChild(h);
    const grid = document.createElement('div'); grid.className = 'lk-grid';
    if (level.id === 'combos') {
      (g.families || []).forEach(f => {
        const b = document.createElement('button'); b.type = 'button'; b.className = 'lk-ch';
        b.setAttribute('aria-pressed', String(sel.has(f.k)));
        b.innerHTML = `<b lang="kn">${f.k}</b><small>${f.r} series</small>`;
        b.onclick = () => { sel.has(f.k) ? sel.delete(f.k) : sel.add(f.k); renderLevels(); };
        grid.appendChild(b);
      });
    } else g.items.forEach(i => {
      const b = document.createElement('button'); b.type = 'button'; b.className = 'lk-ch';
      b.setAttribute('aria-pressed', String(sel.has(i.k)));
      b.innerHTML = `<b lang="kn">${i.k}</b><small>${i.r}</small>`;
      b.onclick = () => { sel.has(i.k) ? sel.delete(i.k) : sel.add(i.k); renderLevels(); };
      grid.appendChild(b);
    });
    box.appendChild(grid);
  });
  const noun = level.id === 'combos' ? 'families' : 'letters';
  $('lk-go').textContent = sel.size ? `Start with ${sel.size} ${noun}` : 'Start';
  $('lk-need').textContent = level.id === 'combos' ? 'Pick at least 4 consonant families.' : 'Pick at least 4 letters.';
  $('lk-need').hidden = sel.size >= 4;
}
function selectedItems() {
  return level.id === 'combos' ? ALL.filter(i => i.family && sel.has(i.family)) : ALL.filter(i => sel.has(i.k));
}
function show(id: string) { ['lk-start','lk-play','lk-end'].forEach(x => ($(x).hidden = x !== id)); }
function next() {
  locked = false;
  cur = round[roundIndex++];
  const wrong = shuffle(pool.filter(i => i.r !== cur.r)).slice(0, 3);
  $('lk-glyph').textContent = cur.k;
  const box = $('lk-opts'); box.innerHTML = '';
  shuffle([cur, ...wrong]).forEach(o => {
    const b = document.createElement('button'); b.type = 'button'; b.className = 'lk-opt'; b.textContent = o.r;
    b.onclick = () => pick(b, o); box.appendChild(b);
  });
}
function pick(btn: HTMLElement, o: Item) {
  if (locked || left <= 0) return; locked = true; asked++;
  if (o.r === cur.r) { score++; btn.classList.add('ok'); }
  else { btn.classList.add('bad'); missed.set(cur.k, cur); [...$('lk-opts').children].forEach(c => { if (c.textContent === cur.r) c.classList.add('ok'); }); }
  $('lk-score').textContent = String(score);
  setTimeout(() => { if (left > 0) { if (asked >= 20) end(); else next(); } }, o.r === cur.r ? 250 : 800);
}
function tick() {
  left--; $('lk-time').textContent = Math.max(left, 0) + 's';
  ($('lk-bar-fill') as HTMLElement).style.width = (left / DURATION * 100) + '%';
  if (left <= 0) end();
}
function start() {
  if (challengeToPlay) {
    level = challengeToPlay.level; ALL = level.groups.flatMap(g => g.items); pool = ALL;
    round = challengeToPlay.questions.slice(); challengeToPlay = null;
    sel = new Set(selectionKeys(level)); renderLevels();
    $('lk-challenge-note').hidden = false;
  } else {
    if (sel.size < 4) { $('lk-need').hidden = false; return; }
    pool = selectedItems(); round = makeRound(pool);
    $('lk-challenge-note').hidden = true;
  }
  roundIndex = 0;
  score = 0; asked = 0; left = DURATION; missed = new Map();
  $('lk-score').textContent = '0'; $('lk-time').textContent = DURATION + 's';
  ($('lk-bar-fill') as HTMLElement).style.width = '100%';
  show('lk-play'); next(); clearInterval(timer); timer = window.setInterval(tick, 1000);
}
function end() {
  clearInterval(timer); locked = true;
  $('lk-final').textContent = String(score);
  $('lk-summary').textContent = `${score} right out of 20.`;
  const comparison = $('lk-comparison');
  if (challengerScore !== null) {
    comparison.innerHTML = `You: ${score}/20<br>Challenger: ${challengerScore}/20`;
    comparison.hidden = false;
  } else comparison.hidden = true;
  const shareText = `I scored ${score}/20 on the Learn to read Kannada app - beat me`;
  const challengeIndexes = round.map(item => ALL.findIndex(candidate => candidate.k === item.k && candidate.r === item.r));
  const challengePayload = btoa(JSON.stringify([level.id, score, ...challengeIndexes])).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
  const challengeUrl = new URL('https://www.venumadhavpandit.com/learn-kannada/');
  challengeUrl.searchParams.set('challenge', challengePayload);
  const shareUrl = challengeUrl.toString();
  const shareData = { title:'Learn to read Kannada - challenge', text:`${shareText}\n${shareUrl}`, url:shareUrl };
  const shareParam = encodeURIComponent(`${shareText} ${shareUrl}`);
  ($('lk-share-whatsapp') as HTMLAnchorElement).href = `https://wa.me/?text=${shareParam}`;
  ($('lk-share-x') as HTMLAnchorElement).href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`;
  ($('lk-share-linkedin') as HTMLAnchorElement).href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;
  ($('lk-share-facebook') as HTMLAnchorElement).href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}&quote=${encodeURIComponent(shareText)}`;
  const nativeShare = $('lk-native-share') as HTMLButtonElement;
  nativeShare.hidden = !('share' in navigator);
  nativeShare.onclick = async () => { try { await navigator.share(shareData); } catch (err) { if ((err as DOMException).name !== 'AbortError') console.error(err); } };
  $('lk-copy-label').textContent = 'Copy link';
  ($('lk-copy-link') as HTMLButtonElement).onclick = async () => { try { await navigator.clipboard.writeText(shareUrl); $('lk-copy-label').textContent = 'Copied!'; setTimeout(() => { $('lk-copy-label').textContent = 'Copy link'; }, 1800); } catch { window.prompt('Copy this link:', shareUrl); } };
  const m = $('lk-missed'); m.innerHTML = '';
  missed.forEach(i => { const c = document.createElement('span'); c.className = 'lk-chip'; c.innerHTML = `<b lang="kn">${i.k}</b>${i.r}`; m.appendChild(c); });
  show('lk-end');
}
$('lk-all').onclick = () => { selectionKeys(level).forEach(k => sel.add(k)); renderLevels(); }; $('lk-none').onclick = () => { sel.clear(); renderLevels(); };
$('lk-go').onclick = start; $('lk-again').onclick = () => { challengerScore = null; challengeToPlay = null; $('lk-challenge-note').hidden = true; history.replaceState(null, '', location.pathname); show('lk-start'); renderLevels(); };
renderLevels();
if (challengeToPlay) start();
</script>
