---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('writing')).sort((a,b)=>b.data.date.localeCompare(a.data.date));
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<Base title="Writing" description="Notes and explainers by Venumadhav Pandit."><header class="container page-intro"><span class="eyebrow">Notes and explainers</span><h1 class="page-title">Writing</h1><p class="lede">Things I've learned, explained in everyday terms.</p></header><section class="container section" style="padding-top:0"><div class="writing-list">{posts.map(post=><a class="writing-card" href={`${base}/writing/${post.id}/`}><div><span class="eyebrow">{`October 2026 · Part ${post.data.title.match(/\(Part\s*([^)]+)\)/)?.[1] ?? '1'}`}</span><h2>{post.data.title}</h2><p>{post.data.summary}</p><span class="writing-read">Read the article ↗</span></div><img src={`${base}${post.data.image}`} alt={post.data.imageAlt} loading="lazy" width="800" height="533"/></a>)}</div></section></Base>
