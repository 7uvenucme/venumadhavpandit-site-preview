---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
const page = (await getEntry('pages', 'about'))!;
const d = page.data;
const { Content } = await render(page);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={d.title} description={d.description}><div class="container page-intro"><span class="eyebrow">{d.eyebrow}</span><h1 class="page-title">{d.pageTitle}</h1><p class="lede">{d.lede}</p></div><article class="container content"><figure><img src={`${base}${d.figureImage}`} alt={d.figureAlt}/><figcaption>{d.figureCaption}</figcaption></figure><Content /><h2>{d.experienceHeading}</h2><div class="timeline">{(d.experience ?? []).map(item=><div class="timeline-item"><span class="metadata">{item.years}</span><div><strong>{item.org}</strong><br/>{item.role}</div></div>)}</div><h2>{d.educationHeading}</h2><div class="timeline">{(d.education ?? []).map(item=><div class="timeline-item"><span class="metadata">{item.years}</span><div><strong>{item.org}</strong><br/>{item.role}</div></div>)}</div></article></Base>
