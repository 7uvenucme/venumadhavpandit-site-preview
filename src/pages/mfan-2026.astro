---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
const page = (await getEntry('pages', 'mfan-2026'))!;
const d = page.data;
const { Content: Terms } = await render((await getEntry('pages', 'mfan-terms'))!);
const { Content: Privacy } = await render((await getEntry('pages', 'mfan-privacy'))!);
---
<Base title={d.title} description={d.description}><div class="container page-intro"><span class="eyebrow">{d.eyebrow}</span><h1 class="page-title">{d.pageTitle}</h1><p class="lede">{d.lede}</p><a class="text-link" href={`${import.meta.env.BASE_URL}builds/mfan-2026/`}>{d.storyLinkLabel} ↗</a></div><article class="container content"><h2>{d.releasesHeading}</h2>{(d.releases ?? []).map(release=><div class="release"><strong>Version {release.heading}</strong><p>{release.body}</p></div>)}<section id="terms" class="policy"><h2>{d.termsHeading}</h2><Terms /></section><section id="privacy" class="policy"><h2>{d.privacyHeading}</h2><Privacy /></section></article></Base>
