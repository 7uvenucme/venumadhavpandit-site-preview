---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
const d = (await getEntry('pages', 'contact'))!.data;
---
<Base title={d.title} description={d.description}><div class="container page-intro"><span class="eyebrow">{d.eyebrow}</span><h1 class="page-title">{d.pageTitle}</h1><p class="lede">{d.lede}</p><a class="button" href={`mailto:${d.email}`}>{d.email} ↗</a></div><div class="container content"><p>Or find me on <a href={d.linkedinUrl} target="_blank" rel="noopener noreferrer">{d.linkedinLabel}</a>.</p></div></Base>
