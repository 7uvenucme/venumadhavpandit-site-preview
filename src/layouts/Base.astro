---
import '../styles/global.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const nav = [{label:'Home',path:'/'},{label:'Builds',path:'/builds/'},{label:'About',path:'/about/'},{label:'Contact',path:'/contact/'}];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f7f8f5"/><title>{title} | Venumadhav Pandit</title><link rel="icon" href={href('/favicon.svg')} type="image/svg+xml"/></head>
<body><a class="skip" href="#main">Skip to content</a><header class="site-header"><nav class="container nav" aria-label="Main navigation"><a href={href('/')} class="brand"><img class="brand-mark" src={href('/images/vp-logo-crop.png')} alt=""/><span class="brand-name">Venumadhav<span>.</span> Pandit</span></a><div class="nav-links">{nav.map(item => <a href={href(item.path)} class:list={{active: Astro.url.pathname === href(item.path)}}>{item.label}</a>)}</div></nav></header><main id="main"><slot/></main><footer class="footer"><div class="container footer-inner"><span>© {new Date().getFullYear()} Venumadhav Pandit</span><div class="split-links"><a href="mailto:7uvenucme@gmail.com">Email</a><a href="https://www.linkedin.com/in/venumadhav-pandit/" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={href('/mfan-2026/#privacy')}>MFan privacy</a></div></div></footer></body></html>
