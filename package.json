{
  "name": "venumadhavpandit-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "npm run validate:content && tinacms build && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate:content": "node scripts/validate-content.mjs",
    "build:ev": "esbuild src/ev-planner/main.tsx --bundle --minify --format=iife --alias:@instinct/files=./src/ev-planner/shim.tsx --loader:.json=json --outfile=public/ev-planner/app.js"
  },
  "dependencies": {
    "@tinacms/cli": "^3.1.0",
    "astro": "^5.14.0",
    "tinacms": "^3.14.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.2"
  }
}